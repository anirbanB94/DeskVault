{
    "Application": {
        "Name": "DeskVault",
        "Version": "1.0.0",
        "Environment": "Development"
    },

    "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "phi4-mini",
        "TimeoutSeconds": 300
    },

    "Database": {
        "Provider": "SQLite"
    },

    "Storage": {
        "DataDirectory": "Data",
        "LogDirectory": "Logs",
        "TempDirectory": "Temp"
    },

    "DocumentProcessing": {
        "MaxChunkSize": 4000,
        "ChunkOverlap": 0,
        "MaxDecryptedDocumentBytes": 33554432,
        "MaxProcessedTextBytes": 33554432,
        "MaxParserNestingDepth": 64,
        "MaxStructuredNodeCount": 100000,
        "MaxCsvRows": 100000,
        "MaxCsvColumns": 1024,
        "MaxCsvFieldLength": 1048576,
        "MaxCsvCells": 500000,
        "MaxIniEntries": 100000,
        "MaxIniLineLength": 1048576
    },

    "CsvParsing": {
        "MaxRows": 10000
    },

    "Search": {
        "PageSize": 20
    },

    "MarkdownRendering": {
        "AllowRawHtml": false,
        "AllowExternalResources": false,
        "AllowExternalNavigation": false
    },

    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30
                }
            }
        ]
    }
}
